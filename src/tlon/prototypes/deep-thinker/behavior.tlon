; 深度思考者：多轮评审的思考程序（total spec——文件即全部行为）
; 阶段 7c：显式 stage 程序——think/act 之后评审本轮输出，FAIL 时把反馈喂回上下文
{:version 1
 :rules [{:name "respond"
          :on :mail-delivered
          :when (or (addressed-to-me? msg) (cc-ed? msg))
          :loop {:context {:sections [(persona) (protocol) (knowledge) (skills) (mail-history 20)]}
                 :stages [(think) (act) (critique) (revise {:if (critique-failed?)})]
                 :until (or (iteration-limit-reached?) (error-limit-reached?))
                 :max-iterations 25
                 :max-consecutive-errors 3
                 :reflect {:enabled true :interval-minutes 10}}}
         {:name "boot"
          :on :boot
          :actions []}]}
