(ns work.main (:require [tlon.agent :as agent]) (:export boot handle))
(defn boot [event] {:result nil})
(defn handle [event]
  (agent/respond event {:method "reviewed" :max_rounds 10 :history_limit 20
                        :max_tokens 512
                        :review_instructions "核验结论是否有具体来源、计算过程或实际工具结果支撑，区分事实、推断与未核实内容。未执行的工具不构成证据；无法支持的断言必须修订或删除。"}))
