{:version 1 :execution {:level :L2} :rules [{:name "respond" :on :mail-delivered :actions [(run-loop (quote {:context {:sections [(persona) (protocol) (lessons) (skills) (knowledge) (current-task) (mail-history 20 10) (thread-recap)]} :stages [(think) (critique {:if (get round :sending_mail) :instructions "核验待交付结论是否有具体来源、计算过程或实际工具结果支撑；明确区分事实、推断和未核实内容。不得把未执行的查询、计算或测试写成已完成查证。没有可验证来源时必须明确说明局限；无法支持的断言应修订或删除。"}) (act {:if (or (not (get round :sending_mail)) (= (get (get scratch :critique) :passed) true))}) (revise {:if (and (get round :sending_mail) (not (= (get (get scratch :critique) :passed) true)))})] :until (or (>= (get state :iteration) (get limits :max_iterations)) (>= (get state :error_count) (get limits :max_consecutive_errors)) (>= (get state :token_usage) (get limits :max_tokens))) :max-iterations 10 :max-consecutive-errors 3 :max-tokens 1000000 :reflect {:enabled true :interval-minutes 15}}))] :when (or (contains? (or (mail-field msg :to) []) (get self :address)) (contains? (or (mail-field msg :cc) []) (get self :address)))} {:name "boot" :on :boot :actions []}]}
