{:version 1 :execution {:level :L0} :rules [{:name "respond" :on :mail-delivered :actions [(run-loop (quote {:context {:sections [(persona) (protocol) (lessons) (skills) (knowledge) (current-task) (mail-history 20 10) (thread-recap)]} :stages [(think) (critique {:if (get round :sending_mail)}) (act {:if (or (not (get round :sending_mail)) (not (= (get (get scratch :critique) :passed) false)))}) (revise {:if (= (get (get scratch :critique) :passed) false)})] :until (or (>= (get state :iteration) (get limits :max_iterations)) (>= (get state :error_count) (get limits :max_consecutive_errors)) (>= (get state :token_usage) (get limits :max_tokens))) :max-iterations 10 :max-consecutive-errors 3 :max-tokens 1000000 :reflect {:enabled true :interval-minutes 15}}))] :when (or (contains? (or (mail-field msg :to) []) (get self :address)) (contains? (or (mail-field msg :cc) []) (get self :address)))} {:name "boot" :on :boot :actions []}]}
