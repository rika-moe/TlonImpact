{:version 1 :execution {:level :L0} :rules [{:name "respond" :on :mail-delivered :actions [(run-loop (quote {:context {:sections [(persona) (protocol) (lessons) (skills) (knowledge) (current-task) (mail-history 20 10) (thread-recap)]} :stages [(think) (critique {:if (sending-mail?)}) (act {:if (or (not (sending-mail?)) (not (critique-failed?)))}) (revise {:if (critique-failed?)})] :until (or (iteration-limit-reached?) (error-limit-reached?) (token-limit-reached?)) :max-iterations 10 :max-consecutive-errors 3 :max-tokens 1000000 :reflect {:enabled true :interval-minutes 15}}))] :when (or (addressed-to-me? msg) (cc-ed? msg))} {:name "boot" :on :boot :actions []}]}
