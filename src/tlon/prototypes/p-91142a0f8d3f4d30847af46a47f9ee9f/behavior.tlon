{:version 1 :execution {:level :L0} :parameters {:sender {:type :string :required true} :pattern {:type :string :required true} :to {:type :string-list :required true}} :rules [{:name "route" :on :mail-delivered :when (and (= (get event :recipient) (get self :id)) (from? msg ${sender}) (content-matches? msg ${pattern})) :actions [(mail-forward {:mail_id (mail-field msg :id) :to ${to}}) (mail-mark-read {:mail_ids [(mail-field msg :id)]})]} {:name "boot" :on :boot :actions []}]}
