{:version 1 :execution {:level :L0} :rules [{:name "respond" :on :mail-delivered :when (or (contains? (or (mail-field msg :to) []) (get self :address)) (contains? (or (mail-field msg :cc) []) (get self :address))) :actions [(run-loop (quote {:context {:sections [(persona) (protocol) (current-task) (mail-history 5) (thread-recap)]} :stages [(think) (act)] :until (or (>= (get state :iteration) (get limits :max_iterations)) (>= (get state :error_count) (get limits :max_consecutive_errors)) (>= (get state :token_usage) (get limits :max_tokens))) :max-iterations 3 :max-consecutive-errors 3 :max-tokens 32000 :reflect {:enabled true :interval-minutes 15}}))]} {:name "boot" :on :boot :actions []}]}
