; 档案管理者：标准 ReAct 程序，高频记忆反思（total spec——文件即全部行为）
{:version 1
 :rules [{:name "respond"
          :on :mail-delivered
          :when (or (addressed-to-me? msg) (cc-ed? msg))
          :loop {:context {:sections [(persona) (protocol) (knowledge) (skills) (current-task) (mail-history 20)]}
                 :stages [(think) (act)]
                 :until (or (iteration-limit-reached?) (error-limit-reached?))
                 :max-iterations 10
                 :max-consecutive-errors 3
                 :reflect {:enabled true :interval-minutes 5}}}
         {:name "boot"
          :on :boot
          :actions []}]}
