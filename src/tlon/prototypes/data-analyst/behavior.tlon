{:version 1 :rules [{:name "respond" :on :mail-delivered :actions [] :when (or (addressed-to-me? msg) (cc-ed? msg)) :loop {:context {:sections [(persona) (protocol) (knowledge) (skills) (current-task) (thread-recap) (mail-history 20)]} :stages [(think) (critique {:if (completing?)}) (act {:if (or (not (completing?)) (not (critique-failed?)))}) (revise {:if (critique-failed?)})] :until (or (iteration-limit-reached?) (error-limit-reached?)) :max-iterations 10 :max-consecutive-errors 3 :reflect {:enabled true :interval-minutes 15}}} {:name "boot" :on :boot :actions []}]}
