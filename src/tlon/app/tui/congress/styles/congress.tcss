/* Congress TUI Styles */

/* Main container */
#main-container {
    width: 100%;
    height: 100%;
    layout: vertical;
}

/* Header bar */
#header-bar {
    width: 100%;
    height: 3;
    background: $primary-darken-2;
    color: $text;
    padding: 0 2;
    align: left middle;
}

#title {
    width: auto;
    text-style: bold;
    content-align: center middle;
}

#agent-count {
    width: auto;
    margin-left: 2;
    color: $text-muted;
}

#connection-status {
    width: 1fr;
    text-align: right;
    color: $text-muted;
    text-style: dim;
}

/* Chat view */
#chat-view {
    width: 100%;
    height: 1fr;
    background: $surface-darken-1;
    border: solid $primary-darken-3;
    padding: 1;
}

/* Input area */
#input-area {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 10;
    background: $surface;
    border-top: solid $primary-darken-2;
    padding: 0 1;
    align: center middle;
}

#send-button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}

/* Message bubbles */
MessageBubble {
    width: 100%;
    height: auto;
    margin: 1 0;
}

MessageBubble.user {
    align: right middle;
}

MessageBubble.agent {
    align: left middle;
}

MessageBubble.system {
    align: center middle;
}

MessageBubble .bubble-content {
    width: auto;
    max-width: 80%;
    padding: 1 2;
}

MessageBubble.user .bubble-content {
    background: $primary-darken-1;
    color: $text;
    border-right: solid $primary;
}

MessageBubble.agent .bubble-content {
    background: $surface-lighten-1;
    color: $text;
    border-left: solid $primary;
}

MessageBubble.system .bubble-content {
    background: transparent;
    color: $text-muted;
    text-style: dim;
}

MessageBubble .sender-name {
    text-style: bold;
    margin-bottom: 1;
}

MessageBubble .timestamp {
    color: $text-muted;
    text-style: dim;
    margin-left: 1;
}

MessageBubble .avatar {
    width: 3;
    content-align: center middle;
}

/* Code blocks */
CodeBlock {
    width: 100%;
    height: auto;
    background: $surface-darken-1;
    border: solid $primary-darken-2;
    padding: 0 1;
    margin: 1 0;
}

CodeBlock .code-header {
    height: 1;
    background: $primary-darken-3;
    padding: 0 1;
}

CodeBlock .code-lang {
    width: 1fr;
    text-style: bold;
    color: $text-muted;
}

CodeBlock .code-content {
    padding: 1;
}

/* Agent selector */
AgentSelector #selector-button {
    width: auto;
    min-width: 6;
    content-align: center middle;
}

AgentSelector #dropdown {
    width: 30;
    height: auto;
    max-height: 15;
    background: $surface;
    border: solid $primary;
    display: none;
    position: absolute;
    layer: popup;
}

AgentSelector #dropdown.open {
    display: block;
}

/* Mention popup */
MentionPopup {
    width: 30;
    height: auto;
    max-height: 12;
    background: $surface;
    border: solid $primary;
    display: none;
    position: absolute;
    layer: popup;
}

MentionPopup.open {
    display: block;
}

/* Command palette */
CommandPalette {
    width: 40;
    height: auto;
    max-height: 15;
    background: $surface;
    border: solid $primary;
    display: none;
    position: absolute;
    layer: popup;
}

CommandPalette.open {
    display: block;
}

/* Scrollbar styling */
::-webkit-scrollbar {
    width: 1;
}

::-webkit-scrollbar-track {
    background: $surface-darken-2;
}

::-webkit-scrollbar-thumb {
    background: $primary-darken-2;
}

::-webkit-scrollbar-thumb:hover {
    background: $primary;
}

/* Focus states */
*:focus {
    border: solid $primary;
}

Input:focus {
    border: solid $primary;
}

Button:focus {
    border: solid $primary-lighten-2;
}

ListView:focus {
    border: solid $primary;
}

ListView > ListItem:focus {
    background: $primary-darken-2;
}

ListView > ListItem:hover {
    background: $primary-darken-2;
}

ListView > ListItem.selected {
    background: $primary;
}
