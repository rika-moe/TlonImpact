#!/bin/sh
# Git's credential protocol: never persist credentials; answer only this origin.
[ "$1" = get ] || exit 0
protocol= host= username=
while IFS= read -r line && [ -n "$line" ]; do
    case "$line" in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
        username=*) username=${line#username=} ;;
    esac
done
[ -n "$protocol" ] && [ -n "$host" ] || exit 0
[ "$protocol://$host" = "$TLON_GITEA_URL" ] || exit 0
[ -z "$username" ] || [ "$username" = "$TLON_GITEA_USERNAME" ] || exit 0
[ -n "$TLON_GITEA_USERNAME" ] && [ -n "$TLON_GITEA_TOKEN" ] || exit 0
printf 'username=%s\npassword=%s\n\n' "$TLON_GITEA_USERNAME" "$TLON_GITEA_TOKEN"
