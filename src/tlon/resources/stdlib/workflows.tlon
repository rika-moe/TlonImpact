(ns tlon.workflows
  (:require [tlon.messages :as messages] [tlon.conversation :as conversation] [tlon.context :as context])
  (:export short-turn plan-then-act evidence-check route forward))

(defn short-turn [options] (conversation/run (assoc options :max_rounds 3)))
(defn plan-then-act [options]
  (let [planning (messages/append (get options :messages)
                   (messages/user "Plan the work. Do not claim execution. Return a concise plan."))
        plan (context/complete (assoc options :messages planning :tools []))
        history (messages/append (messages/append planning (messages/response plan))
                  (messages/user "Execute this plan using available tools; distinguish evidence from assumptions."))]
    (conversation/run (assoc options :messages history))))

;; Sequential evidence gathering retains every prior request and tool result.
(defn evidence-check [options]
  (let [first (conversation/run options)
        checking (messages/append (get first :messages)
                   (messages/user "Retrieve and cross-check the claim. Seek contrary evidence and cite sources. End with finish-turn."))
        second (conversation/run (assoc options :messages checking))
        comparing (messages/append (get second :messages)
                    (messages/user "Compare the gathered evidence. Separate committed tool evidence, proposals and uncertainty. Report disagreements rather than inventing consensus."))
        result (context/complete (assoc options :messages comparing :tools []))]
    {:content (get result :content) :messages (messages/append comparing (messages/response result))
     :reason "cross-checked"}))

;; Routing remains a local policy choice; the selected method is an ordinary function.
(defn route [options]
  (let [method (get options :method "short-turn")]
    (if (= method "short-turn") (short-turn options)
      (if (= method "plan-then-act") (plan-then-act options)
        (if (= method "evidence-check") (evidence-check options)
          (assert false "unknown work method"))))))
(defn forward [recipient mail-id] (mail-forward {:to [recipient] :mail_id mail-id}))
