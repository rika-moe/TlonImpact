(ns tlon.conversation
  (:require [tlon.messages :as messages] [tlon.context :as context])
  (:export run step))

(defn step [options]
  (let [tools (get options :tools [])
        prepared (context/fit options)
        response (context/invoke prepared)
        calls (get response :tool_calls [])
        ends (filter call (= (get call :name) "finish-turn") calls)
        required (assert (> (count calls) 0) "action loop requires tool calls")
        checked (if (> (count ends) 0)
                  (assert (and (= (count calls) 1)
                               (= (get (reduce previous call call nil calls) :arguments) {}))
                          "finish-turn must be an empty standalone call") true)
        results (tool-execute {:tools tools :tool_calls calls})
        finished (if (> (count ends) 0)
                   (assert (and (= (count results) 1)
                                (get (reduce previous result result nil results) :success))
                           "finish-turn execution failed") false)]
    {:response response :results results :finished finished
     :messages (messages/exchange (get prepared :messages) response results)}))

;; Linked only when an author explicitly requires tlon.conversation.
;; This is an ordinary bounded function. All effects retain the caller's scope.
(defn run [options]
  (let [limit (get options :max_rounds)]
    (assert (and (integer? limit) (> limit 0)) "max_rounds must be a positive integer")
    (while [history (get options :messages) round 0]
      true
      (if (>= round limit)
        (assert false "conversation round-limit reached before finish-turn")
        (let [result (step (assoc options :messages history))]
          (if (get result :finished)
            {:content nil :messages (get result :messages) :reason "finish-turn"}
            (recur (get result :messages) (+ round 1))))))))
