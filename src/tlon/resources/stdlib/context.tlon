(ns tlon.context
  (:require [tlon.messages :as messages])
  (:export assemble groups fit complete request invoke resource-policy handoff))

(defn request [options]
  (let [base {:messages (get options :messages) :tools (get options :tools [])
              :cache_prefix_len (get options :cache_prefix_len 0)}
        limit (get options :max_tokens)]
    (if (= limit nil) base (assoc base :max_tokens limit))))

(defn append-all [left right] (reduce result item (conj result item) left right))
(defn nth [items index]
  (get (reduce state item
         {:index (+ (get state :index) 1)
          :value (if (= (get state :index) index) item (get state :value))}
         {:index 0 :value nil} items) :value))
;; Consume each message once, and emit only complete assistant/tool groups.
(defn groups [history]
  (let [state (reduce state message
          (let [pending (get state :pending) index (get state :index)
                result (get state :groups) current (get state :current)]
            (if (< index (count pending))
              (let [id (nth pending index) next (+ index 1)
                    group (conj current message)]
                (assert (and (= (get message :role) "tool") (= (get message :tool_call_id) id))
                        "tool results must match declared order")
                (if (= next (count pending))
                  {:pending [] :index 0 :groups (conj result group) :current []}
                  {:pending pending :index next :groups result :current group}))
              (let [calls (get message :tool_calls [])
                    ids (reduce ids call
                          (let [id (get call :id)]
                            (assert (and (= id (str id)) (not (= id ""))) "tool call requires nonempty id")
                            (assert (not (contains? ids id)) "duplicate tool call id")
                            (conj ids id)) [] calls)]
                (assert (not (= (get message :role) "tool")) "orphan tool result")
                (if (> (count ids) 0)
                  (let [role (assert (= (get message :role) "assistant") "tool calls require assistant")]
                    {:pending ids :index 0 :groups result :current [message]})
                  {:pending [] :index 0 :groups (conj result [message]) :current []}))))
          {:pending [] :index 0 :groups [] :current []} history)]
    (assert (= (count (get state :pending)) 0) "incomplete tool exchange")
    (get state :groups)))

(defn assemble [options]
  (append-all (get options :prefix [])
    (append-all (get options :history []) [(messages/user (get options :task))])))

(defn smaller [left right] (if (< left right) left right))
(defn larger [left right] (if (> left right) left right))

;; A run never rewrites its input prefix to make space.
(defn fit [options]
  (let [pressure (model-context (request options))]
    (assert (get pressure :fits) "context window exhausted; run history cannot be rewritten")
    options))

;; Leave room for a boundary handoff, including re-reading the prefix under total billing.
(defn resource-policy [options]
  (let [pressure (model-context (request (assoc options :max_tokens nil)))
        window (get pressure :context_window)
        input (get pressure :input_tokens)
        window-reserve (larger 1 (quot window 10))
        budget-reserve (larger 1 (quot (get pressure :token_budget_limit) 10))
        remaining (get pressure :token_budget_remaining)
        budget-output (if (= (get pressure :token_budget_measure) "total")
                        (quot (- (- (- remaining (* 2 input)) window-reserve) budget-reserve) 2)
                        (- remaining budget-reserve))
        window-output (- (- window input) window-reserve)
        available (smaller (get pressure :output_tokens) (smaller window-output budget-output))
        cap (if (= (get options :max_tokens) nil) available
              (smaller available (get options :max_tokens))) ]
    (assert (and (get pressure :fits) (> cap 0)) "insufficient resources while preserving boundary handoff reserve")
    (assoc options :max_tokens cap)))

;; Only callers that have completed their task may invoke this boundary function.
;; The original history is retained, and the summary is a separate next-run starting point.
(defn handoff [options source]
  (let [pressure (model-context (request (assoc options :max_tokens nil)))
        window-reserve (larger 1 (quot (get pressure :context_window) 10))
        budget-reserve (larger 1 (quot (get pressure :token_budget_limit) 10))]
    (if (< (get pressure :input_tokens) (- (get pressure :context_window) (* 2 window-reserve)))
      {:messages (get options :messages) :continuation nil}
      (let [history (conj (get options :messages)
                      (messages/user (str "Prepare the handoff for the NEXT run. Source run: " source
                        ". Summarize the task, verified tool results, unresolved matters and source attribution. "
                        "Tool suggestions and drafts are not execution receipts. This run's task has already finished. Return only the handoff text.")))
            prepared {:messages history :tools []}
            room (model-context (request prepared))
            cap (smaller (get room :output_tokens) (smaller window-reserve budget-reserve))
            checked (assert (and (get room :fits) (> cap 0)) "insufficient boundary handoff resources")
            response (invoke (assoc prepared :max_tokens cap))
            text (get response :content)]
        (assert (and (= text (str text)) (not (= text ""))
                     (= (count (get response :tool_calls [])) 0)) "handoff requires textual summary without tool calls")
        {:messages (conj history (messages/response response))
         :continuation {:source_run_id source
                        :messages [(messages/user (str "Handoff from source run " source
                              " (historical evidence, not a new execution receipt):\n" text))]}}))))

(defn invoke [prepared]
  (let [result (model-call (request prepared))]
    (assert (not (= (get result :finish_reason) "length")) "model output truncated")
    result))

;; All generated workflow requests use the same ordinary pressure policy.
(defn complete [options] (invoke (fit options)))
