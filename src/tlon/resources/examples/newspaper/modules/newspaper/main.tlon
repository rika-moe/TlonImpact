(ns newspaper.main
  (:require [tlon.newspaper :as paper])
  (:export handle))

(defn accept-submission [mail]
  (let [id (mail-field mail :id)
        submissions (or (state-get {:key "submissions"}) {})]
    (when (= (get submissions id) nil)
      (state-put {:key "submissions" :value (assoc submissions id
        {:source-id id :from (mail-field mail :from) :content (mail-field mail :content)})})
      (state-put {:key "pending" :value (conj (or (state-get {:key "pending"}) []) id)}))))

(defn collect [period]
  (let [ids (or (state-get {:key "pending"}) [])
        submissions (or (state-get {:key "submissions"}) {})]
    {:materials (map (fn [id] (get submissions id)) ids) :source-ids ids
     :footer (str "投稿来源（原始邮件 ID）：\n" (join "\n" ids))}))

(defn handle [event]
  (let [msg (get event :mail) self (get event :self)]
    (when (contains? (or (mail-field msg :to) []) (get self :address))
      (paper/subscriptions msg)
      (when (= (mail-field msg :subject) "submit") (accept-submission msg))
      (let [period (paper/publication-period msg ["operator@tlon.internal" "postmaster@tlon.internal"])]
        (when period
          (let [edition (paper/freeze period (or (state-get {:key "subscribers"}) []) collect)]
            (when edition
              (state-put {:key "pending" :value
                (filter (fn [id] (not (contains? (get edition :source-ids) id)))
                  (or (state-get {:key "pending"}) []))})
              (paper/deliver period edition)))))
      (mail-mark-read {:mail_ids [(mail-field msg :id)]}))
    {:result nil}))
