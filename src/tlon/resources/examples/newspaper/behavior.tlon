{:version 1
 :execution {:level :L0}
 :rules
 [{:name "newspaper"
   :on :mail-delivered
   :when (addressed-to-me? msg)
   :fuel 10000
   :actions
   [(defn accept-submission [mail]
      (let [id (mail-field mail :id)
            submissions (or (state-get "submissions") {})]
        (when (= (get submissions id) nil)
          (state-put "submissions"
            (assoc submissions id {:source-id id
                                   :from (mail-field mail :from)
                                   :content (mail-field mail :content)}))
          (state-put "pending" (conj (or (state-get "pending") []) id)))))

    (defn freeze-edition [period subscribers]
      (let [key (str "edition:" period)
            frozen (state-get key)]
        (if frozen
          frozen
          (let [ids (or (state-get "pending") [])
                submissions (or (state-get "submissions") {})
                stories (map id (get submissions id) ids)]
            (if (= (count ids) 0)
              (state-put key {:period period :content "" :source-ids []
                              :subscribers subscribers :delivered {}})
              (let [result (llm-call
                             {:prompt (str "请用中文编辑以下投稿为一份简报。区分投稿人的陈述和已核实事实，"
                                           "不要补写投稿未提供的事实。仅返回非空正文，不生成来源编号。投稿："
                                           stories)
                              :max-tokens 2000})
                    body (get result :content)]
                (when (and body (content-matches? body "\\S"))
                  (let [snapshot
                        {:period period
                         :content (str body "\n\n投稿来源（原始邮件 ID）：\n" (join "\n" ids))
                         :source-ids ids :subscribers subscribers :delivered {}}]
                    (state-put key snapshot)
                    (state-put "pending" [])
                    snapshot))))))))

    (defn deliver-edition [period edition]
      (when (and edition (> (count (get edition :source-ids)) 0))
        (let [key (str "edition:" period)]
          (map address
            (let [current (state-get key)]
              (when (= (get (get current :delivered) address) nil)
                (let [receipt (mail-send
                                {:to [address] :subject (str "报纸：" period)
                                 :content (get edition :content)
                                 :request_id (str "edition:" period ":" address)})]
                  (when (get receipt :mail_id)
                    (state-put key
                      (assoc current :delivered
                        (assoc (get current :delivered) address receipt)))))))
            (get edition :subscribers)))))

    (let [sender (mail-field msg :from)
          subject (mail-field msg :subject)
          subscribers (or (state-get "subscribers") [])]
      (when (= subject "subscribe")
        (when (not (contains? subscribers sender))
          (state-put "subscribers" (conj subscribers sender))))
      (when (= subject "unsubscribe")
        (state-put "subscribers" (filter address (not (= address sender)) subscribers)))
      (when (= subject "submit")
        (accept-submission msg))
      (when (and (from? msg "operator@tlon.internal")
                 (content-matches? subject "^publish:.+$"))
        (let [period (substring subject 8)
              edition (freeze-edition period subscribers)]
          (deliver-edition period edition))))
    (mail-mark-read {:mail_ids [(mail-field msg :id)]})]}
  {:name "boot" :on :boot :actions []}]}
