(ns work.reply
  (:require [tlon.context :as context] [tlon.messages :as messages]
            [tlon.conversation :as conversation] [work.methods :as methods])
  (:export handle))
(defn handle [event]
  (let [mail (get event :mail)
        options {:messages (context/assemble
                             {:task (str (get mail :content)
                                      " Use time-now when evidence requires it. End each action loop with an empty standalone finish-turn call. Text alone cannot end an action loop.")})
                 :tools ["time-now" "finish-turn"] :max_rounds 3}
        answer (methods/answer options)
        delivered (conversation/run
                    {:messages (messages/append (get answer :messages)
                                (messages/user (str "Send this reviewed answer to " (get event :sender)
                                  " using mail-send with in_reply_to " (get mail :id)
                                  ", then call finish-turn alone. Answer: " (get answer :content))))
                     :tools ["mail-send" "finish-turn"] :max_rounds 3})
        read (mail-mark-read {:mail_ids [(get mail :id)]})]
    {:result delivered}))
