(ns work.writing
  (:require [tlon.messages :as messages] [tlon.conversation :as conversation] [tlon.context :as context])
  (:export generate review revise))

(defn generate [task]
  (let [evidence (conversation/run
                   {:messages [(messages/user (str "Call time-now to obtain the current time for this task, then call finish-turn alone: " task))]
                    :tools ["time-now" "finish-turn"] :max_rounds 4})
        draft (context/complete
                {:messages (messages/append (get evidence :messages)
                             (messages/user (str "Using this committed evidence, write a draft answering: " task)))
                 :tools []})]
    (get draft :content)))

(defn review [task draft]
  (get (context/complete {:messages [(messages/user (str "Review this draft against the task: " task))
                                    (messages/assistant draft)
                                    (messages/user "Identify unsupported claims and missing information.")]
                          :tools []}) :content))

(defn revise [task draft review]
  (get (context/complete {:messages [(messages/user (str "Task: " task))
                                    (messages/assistant draft)
                                    (messages/user (str "Revise using this review: " review))]
                          :tools []}) :content))
