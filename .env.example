# Tlon 环境配置模板（ADR 0016：LLM 配置成员级化）
# 复制到 ~/.tlon/.env 后编辑（Tlon 只读 {TLON_HOME}/.env，真实环境变量优先）

# LLM API key：按 provider 分别配置，litellm 原生读取 {PROVIDER}_API_KEY
#（provider 段大写、`-` 换 `_`）。成员用哪家的模型就配哪家的 key；
# 模型选择是成员级配置（agent.yaml 的 llm.model_name，创建成员时在
# WebUI 选择），进程级没有 LLM_* 设置了
#DEEPSEEK_API_KEY=
#ANTHROPIC_API_KEY=
#MOONSHOT_API_KEY=
#OPENAI_API_KEY=

# 可选（ADR 0013）：admin 端点共享 token。配置后 /admin/* 需
# Authorization: Bearer <token>；绑定非回环地址时强烈建议开启
#TLON_ADMIN_TOKEN=

# 可选（issue ）：GitHub webhook 入站。配置 secret 后服务端注册
# POST /webhooks/github（HMAC 验签），GitHub 事件映射为外部来信；
# 不配置则端点不存在。GITHUB_RECIPIENT 为默认收件人 member id
#（agent id 或 human:<username>），留空则发给全体已知人类
#GITHUB_WEBHOOK_SECRET=
#GITHUB_RECIPIENT=
# 可选：GitHub 出站（回信 → issue/PR comment）。GITHUB_TOKEN 是 API
# token（需 repo 读写权限）；留空只禁出站，入站不受影响——回给
# notifications@github.com 的信会留在 gateway:github 邮箱里（审计）
#GITHUB_TOKEN=

# 可选（issue #24）：社会级容器内存总预算（如 4g，docker parse_bytes
# 格式）。所有 tlon-agent-* 容器实际内存占用之和超预算时记
# container_memory_budget_exceeded 警告——仅告警不强制；留空 = 不设预算
#TLON_CONTAINER_MEMORY_BUDGET=
