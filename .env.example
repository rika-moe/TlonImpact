# Tlon Application Configuration

# TLON_HOME specifies the root directory of the Tlon installation.
# This directory should contain 'config' and 'data' folders.
# Default: ~/.tlon (will be created automatically if not exists)
TLON_HOME=$HOME/.tlon

# LLM API Configuration
# Default provider: Moonshot (kimi-k2.5). These env vars use OPENAI_ prefix
# because the Moonshot API is OpenAI-compatible.
OPENAI_API_KEY=your-moonshot-api-key-here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL_NAME=kimi-k2.5  # or kimi-k1.5, gpt-4, gpt-3.5-turbo, etc.
OPENAI_TEMPERATURE=1.0

# Optional: Alternative LLM providers
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_ENDPOINT=...

# Telegram Bot Configuration (for milestone 3)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Application Settings
APP_NAME=Tlon
LOG_LEVEL=INFO
# DATA_DIR: defaults to $TLON_HOME/data (~/.tlon/data if TLON_HOME is not set).
# Uncomment and set to override:
# DATA_DIR=/custom/path/to/data

# Docker Settings
DOCKER_DEFAULT_IMAGE=ubuntu:22.04
DOCKER_NETWORK_MODE=host

# Agent Memory Settings
MEMORY_MAX_HISTORY=1000
MEMORY_SUMMARY_WINDOW=20

# Development Settings
DEBUG=false
