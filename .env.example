# Tlon Application Configuration

# TLON_HOME specifies the root directory of the Tlon installation.
# This directory should contain 'config' and 'data' folders.
# Default: ~/.tlon (will be created automatically if not exists)
# TLON_HOME=$HOME/.tlon

# LLM API Configuration
# Default provider: Moonshot (kimi-k2.5). Uses OPENAI_ prefix because
# the Moonshot API is OpenAI-compatible.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL_NAME=kimi-k2.5
OPENAI_TEMPERATURE=1.0

# Optional: Alternative LLM providers
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_ENDPOINT=...

# Application Settings
APP_NAME=Tlon
LOG_LEVEL=INFO
# DATA_DIR: defaults to $TLON_HOME/data (~/.tlon/data if TLON_HOME is not set).
# DATA_DIR=/custom/path/to/data

# Development Settings
DEBUG=false

# Tracing (OpenTelemetry, optional)
# Trace sampling ratio in [0, 1]; defaults to always-on when unset.
# TLON_TRACE_SAMPLE_RATIO=0.5
# OTLP collector base URL; requires the optional extra (`uv sync --extra otlp`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logging (optional)
# Days to keep daily server log files (~/.tlon/shared/logs/server-{date}.jsonl).
# TLON_LOG_RETENTION_DAYS=7
