# Tlon Application Configuration

# TLON_HOME specifies the root directory of the Tlon installation.
# This directory should contain 'config' and 'data' folders.
# Default: ~/.tlon (will be created automatically if not exists)
TLON_HOME=$HOME/.tlon

# LLM API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4  # or gpt-3.5-turbo, gpt-4-turbo, kimi-k2.5, etc.
OPENAI_TEMPERATURE=0.7   # set to 1.0 for kimi-k2.5

# Optional: Alternative LLM providers
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_ENDPOINT=...

# Telegram Bot Configuration (for milestone 3)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Application Settings
APP_NAME=Tlon
LOG_LEVEL=INFO
DATA_DIR=./data

# Docker Settings
DOCKER_DEFAULT_IMAGE=ubuntu:22.04
DOCKER_NETWORK_MODE=host

# Agent Memory Settings
MEMORY_MAX_HISTORY=1000
MEMORY_SUMMARY_WINDOW=20

# Development Settings
DEBUG=false
